{
  "schema_version": 1,
  "canvas": {
    "width": 320,
    "height": 180,
    "frame_rate": {"numerator": 30, "denominator": 1},
    "duration_frames": 60
  },
  "assets": [
    {"id": "logo", "type": "image", "path": "logo.png"}
  ],
  "layers": [
    {
      "id": "background",
      "type": "solid",
      "start_frame": 0,
      "end_frame": 60,
      "color": [0.04, 0.06, 0.12, 1.0]
    },
    {
      "id": "logo-layer",
      "type": "image",
      "asset": "logo",
      "start_frame": 0,
      "end_frame": 60,
      "fit": "contain",
      "position": [0.5, 0.5],
      "effects": [{"type": "opacity", "value": 0.9}]
    }
  ]
}

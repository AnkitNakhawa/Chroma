cmake_minimum_required(VERSION 3.25)
project(package_consumer LANGUAGES C)
find_package(Chroma 0.1 CONFIG REQUIRED)
add_executable(chroma-sdk-consumer main.c)
target_link_libraries(chroma-sdk-consumer PRIVATE chroma::c)
set_target_properties(chroma-sdk-consumer PROPERTIES C_STANDARD 99)
if(APPLE)
  set_target_properties(chroma-sdk-consumer PROPERTIES INSTALL_RPATH "@loader_path/../lib")
else()
  set_target_properties(chroma-sdk-consumer PROPERTIES INSTALL_RPATH "$ORIGIN/../lib")
endif()
install(TARGETS chroma-sdk-consumer DESTINATION bin)

cmake_minimum_required(VERSION 3.25)
if(CHROMA_SYSTEM STREQUAL "Darwin")
  execute_process(COMMAND "${CHROMA_NM}" -gU "${CHROMA_LIBRARY}" OUTPUT_VARIABLE output RESULT_VARIABLE result)
else()
  execute_process(COMMAND "${CHROMA_NM}" -D --defined-only "${CHROMA_LIBRARY}" OUTPUT_VARIABLE output RESULT_VARIABLE result)
endif()
if(NOT result EQUAL 0)
  message(FATAL_ERROR "unable to inspect C ABI symbols")
endif()
string(REPLACE "\n" ";" lines "${output}")
set(actual "")
foreach(line IN LISTS lines)
  string(STRIP "${line}" line)
  if(NOT line)
    continue()
  endif()
  string(REGEX MATCH "[^ \t]+$" symbol "${line}")
  if(symbol STREQUAL "CHROMA_1")
    continue()
  endif()
  if(NOT symbol MATCHES "^_?chroma_[a-z0-9_]+(@@CHROMA_1)?$")
    message(FATAL_ERROR "unexpected non-C export: ${symbol}")
  endif()
  string(REGEX REPLACE "^_" "" symbol "${symbol}")
  string(REGEX REPLACE "@@CHROMA_1$" "" symbol "${symbol}")
  list(APPEND actual "${symbol}")
endforeach()
file(STRINGS "${CHROMA_SOURCE_DIR}/include/chroma/chroma.h" declarations REGEX "CHROMA_API.*CHROMA_CALL chroma_")
set(expected "")
foreach(declaration IN LISTS declarations)
  string(REGEX MATCH "CHROMA_CALL (chroma_[a-z0-9_]+)" match "${declaration}")
  list(APPEND expected "${CMAKE_MATCH_1}")
endforeach()
list(SORT actual)
list(SORT expected)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "public header/export mismatch: ${actual} vs ${expected}")
endif()
file(STRINGS "${CHROMA_SOURCE_DIR}/tests/abi/v1_symbols.txt" baseline)
foreach(symbol IN LISTS baseline)
  if(NOT symbol IN_LIST actual)
    message(FATAL_ERROR "removed ABI-v1 symbol: ${symbol}")
  endif()
endforeach()
